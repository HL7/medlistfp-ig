      <parentId>MEDLIST</parentId>
      <tag name="Row" value="62"/>
      <tag name="Optionality" value="SHOULD"/>
      <tag name="Conditional" value="N"/>
      <tag name="Dependent" value="N"/>
    </object>
    <object>
      <id>MEDLISTPH.2.5.4#13</id>
      <name>PH.2.5.4#13</name>
      <notes>The system SHALL provide the ability to capture and maintain the date on which allergy information was entered.</notes>
