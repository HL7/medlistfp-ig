      <parentId>MEDLIST</parentId>
      <tag name="Reference.ChangeInfo" value="NC"/>
    </object>
    <object>
      <id>MEDLISTPH.2.5.4#01</id>
      <name>PH.2.5.4#01</name>
      <notes>The system SHALL provide the ability to manage information related to allergy, intolerance, and adverse reaction to drugs, foods, or environmental triggers as unique, discrete entries (including, for example, substances such as latex, metal, and contrast media (such as dye)).</notes>
      <stereotype>CI</stereotype>
      <type>Class</type>
      <parentId>MEDLIST</parentId>
      <tag name="Row" value="53"/>
      <tag name="Optionality" value="SHALL"/>
      <tag name="Conditional" value="N"/>
      <tag name="Dependent" value="N"/>
    </object>
    <object>
      <id>MEDLISTPH.2.5.4#02</id>
      <name>PH.2.5.4#02</name>
      <notes>The system SHOULD provide the ability to capture the reason for entry of the allergy, intolerance or adverse reaction.</notes>
      <stereotype>CI</stereotype>
      <type>Class</type>
      <parentId>MEDLIST</parentId>
      <tag name="Row" value="54"/>
      <tag name="Optionality" value="SHOULD"/>
      <tag name="Conditional" value="N"/>
      <tag name="Dependent" value="N"/>
    </object>
    <object>
      <id>MEDLISTPH.2.5.4#03</id>
      <name>PH.2.5.4#03</name>
      <notes>The system SHALL provide the ability to manage information related to allergic and adverse reactions to drug and non-drug allergens or substances.</notes>
      <stereotype>CI</stereotype>
      <type>Class</type>
      <parentId>MEDLIST</parentId>
      <tag name="Row" value="55"/>
      <tag name="Optionality" value="SHALL"/>
      <tag name="Conditional" value="N"/>
      <tag name="Dependent" value="N"/>
    </object>
    <object>
      <id>MEDLISTPH.2.5.4#04</id>
      <name>PH.2.5.4#04</name>
      <notes>The system SHALL provide the ability to manage information regarding the reaction type.</notes>
      <stereotype>CI</stereotype>
      <type>Class</type>
      <parentId>MEDLIST</parentId>
      <tag name="Row" value="56"/>
      <tag name="Optionality" value="SHALL"/>
      <tag name="Conditional" value="N"/>
      <tag name="Dependent" value="N"/>
    </object>
    <object>
      <id>MEDLISTPH.2.5.4#05</id>
      <name>PH.2.5.4#05</name>
      <notes>The system SHALL provide the ability to manage information regarding the severity of a reaction.</notes>
