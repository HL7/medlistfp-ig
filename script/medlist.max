      <tag name="Reference.FunctionID" value="RI.1.1.1" />
      <tag name="Reference.ChangeIndicator" value="C" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>5abe8045-b751-4408-ad3d-f13df3c950f9</id>
      <name>RI.1.1.1#01</name>
      <notes>The system SHALL provide the ability to capture (originate) a Record Entry instance corresponding to an Action instance and context.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
