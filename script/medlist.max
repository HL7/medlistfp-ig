    </object>
    <object>
      <id>9e1a2cb4-1939-430b-b0e8-e3e3e3305669</id>
      <name>RI.1.1.1#06</name>
      <notes>The system SHOULD provide the ability to integrate Record Entries from Information recorded during system downtime.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
