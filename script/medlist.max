      <tag name="Reference.CriterionID" value="2" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>1dab9ddd-c20a-4bc0-bd65-7b9ec479c54e</id>
      <name>PH.2.5.2#03</name>
      <notes>The system SHOULD provide the ability to capture medication-related dates (e.g., start date, fill date, end date).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>4309c0e6-5488-41be-be93-74aa5b8a0aca</parentId>
      <tag name="Row" value="148" />
      <tag name="Optionality" value="SHOULD" />
      <tag name="Conditional" value="N" />
      <tag name="Dependent" value="N" />
      <tag name="Reference.Alias" value="PHR_R2" />
      <tag name="Reference.FunctionID" value="PH.2.5.2" />
      <tag name="Reference.CriterionID" value="3" />
      <tag name="Reference.ChangeIndicator" value="C" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>3f1def13-869a-47a5-b701-e389be7684bf</id>
      <name>PH.2.5.2#04</name>
      <notes>The system SHALL provide the ability to capture medications that are not on the PHR Account Holder's existing medication list(s) or the existing medication history(s).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>4309c0e6-5488-41be-be93-74aa5b8a0aca</parentId>
      <tag name="Row" value="149" />
      <tag name="Optionality" value="SHALL" />
      <tag name="Conditional" value="N" />
      <tag name="Dependent" value="N" />
      <tag name="Reference.Alias" value="PHR_R2" />
      <tag name="Reference.FunctionID" value="PH.2.5.2" />
      <tag name="Reference.CriterionID" value="4" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>2a075fb6-40c6-43c8-bf46-507aa3543363</id>
      <name>PH.2.5.2#05</name>
      <notes>The system SHOULD provide the ability for the PHR Account Holder to render a notification to a prescriber or provider that the PHR Account Holder believes that a medication was erroneously captured or duplicated.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>4309c0e6-5488-41be-be93-74aa5b8a0aca</parentId>
      <tag name="Row" value="150" />
