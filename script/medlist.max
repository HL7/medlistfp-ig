    <object>
      <id>89ca723c-bedc-4d4c-a61f-253ba605f76e</id>
      <name>S.2.1#03</name>
      <notes>The system SHOULD provide the ability to manage multiple payer sources of health insurance benefits information.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>d1b05ae0-4053-4fc9-bd1a-5ccb2de706e5</parentId>
