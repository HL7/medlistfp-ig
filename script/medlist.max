    <object>
      <id>4dee074c-9f64-472d-961c-9c80322df5be</id>
      <name>PH.6.3#12</name>
      <notes>The system SHALL provide the ability to manage information relevant to the upcoming encounter provided by the patient or account holder (e.g., questionnaires or surveys).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>68e76902-64c5-4fb7-a282-2f25a1383f93</parentId>
