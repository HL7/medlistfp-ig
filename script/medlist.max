    <object>
      <id>05960451-8c62-43a4-86e2-fbd3f46c4b2a</id>
      <name>RI.1.1.4#14</name>
      <notes>The system SHALL capture all signature types of the entities through which Record Entry content has passed.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>b2aecc7d-042f-4dff-9f7e-9d3be485d6c1</parentId>
