    </object>
    <object>
      <id>2ae9aad2-1234-4664-944c-c19ab049b010</id>
      <name>S.2.1#04</name>
      <notes>The system SHOULD capture insurance type (e.g., medical or dental).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>d1b05ae0-4053-4fc9-bd1a-5ccb2de706e5</parentId>
