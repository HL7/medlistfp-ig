    <object>
      <id>b3db725a-d7d8-4eef-befd-76b53c1a011a</id>
      <name>PH.2.5.4#12</name>
      <notes>The system MAY provide the ability to present the list of allergies, intolerances, and/or adverse reactions in an order that is defined by the PHR Account Holder.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>222ed2a6-7618-4381-9fe0-44501b10d8e4</parentId>
