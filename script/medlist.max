    </object>
    <object>
      <id>be9128cf-d64c-413b-9392-744dd7047471</id>
      <name>RI.1.1.1#04</name>
      <notes>The system SHALL provide the ability to capture both structured and unstructured content in Record Entries.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
