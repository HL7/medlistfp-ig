      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>c409dede-d873-4952-9f49-37912522178f</id>
      <name>PH.1.5#08</name>
      <notes>The system SHOULD provide the ability to render electronic copies of authorization and/or consent directives chronologically according to user preference, organizational policy, and/or jurisdictional law.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>e1656db5-4b8e-4ac8-a0ef-ad1e764cdcb2</parentId>
