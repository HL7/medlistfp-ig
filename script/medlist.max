      <tag name="Reference.CriterionID" value="16" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>0e630673-08e3-4aa0-ba01-d86b7fe18e6c</id>
      <name>PH.3.5.4#17</name>
      <notes>The system SHOULD provide the ability to transmit a notification to the PHR Account Holder or the PHR Account Holder's designated representative that a reminder was not acknowledged.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>8b20407d-3890-46ad-9423-70728bd11805</parentId>
      <tag name="Row" value="345" />
      <tag name="Optionality" value="SHOULD" />
      <tag name="Conditional" value="N" />
      <tag name="Dependent" value="N" />
      <tag name="Reference.Alias" value="PHR_R2" />
      <tag name="Reference.FunctionID" value="PH.3.5.4" />
      <tag name="Reference.CriterionID" value="17" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>d974b390-2e19-44f3-9573-4f1dc04af121</id>
      <name>PH.3.5.4#18</name>
      <notes>The system SHALL provide the ability to manage presentation of notices for patient or account holder review (e.g., notices of privacy or information practices).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>8b20407d-3890-46ad-9423-70728bd11805</parentId>
      <tag name="Row" value="82" />
      <tag name="Optionality" value="SHALL" />
      <tag name="Conditional" value="N" />
      <tag name="Dependent" value="N" />
      <tag name="CompilerInclusionReason" value="New from ProfileDefinition" />
