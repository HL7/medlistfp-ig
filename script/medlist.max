      <tag name="Reference.CriterionID" value="1" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>b36b3de8-6d24-4442-bb7e-5e6e46471e2b</id>
      <name>PH.1.5#02</name>
      <notes>The system SHOULD provide the ability to capture information regarding the external location of the PHR Account Holder's applicable consent directives and authorizations according to user preference, organizational policy, and/or jurisdictional law.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>e1656db5-4b8e-4ac8-a0ef-ad1e764cdcb2</parentId>
