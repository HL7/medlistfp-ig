      <tag name="Reference.CriterionID" value="1" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>da12f2c3-4f0a-41ae-a7b1-bb32fcb3f887</id>
      <name>RI.1.1.1#02</name>
      <notes>The system SHALL capture a unique instance identifier for each Record Entry.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
