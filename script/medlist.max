      <id>40aa74b7-db9b-4000-88d8-cfb9d1f9ab8d</id>
      <name>PH.2.5.4#13</name>
      <notes>The system SHALL provide the ability to capture and maintain the date on which allergy information was entered.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>222ed2a6-7618-4381-9fe0-44501b10d8e4</parentId>
