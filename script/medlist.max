    </object>
    <object>
      <id>122f6908-a3ed-4ae9-b4a4-ead159e28245</id>
      <name>RI.1.1.1#05</name>
      <notes>The system SHALL provide the ability to capture Record Entries from information recorded during system downtime.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
