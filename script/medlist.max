    <object>
      <id>8882df7b-3556-4ad4-9b7f-a860e6047786</id>
      <name>RI.1.1.1#03</name>
      <notes>The system SHALL provide the ability to manage attestation(s) indicating receipt of notices.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
