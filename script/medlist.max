      <tag name="Reference.FunctionID" value="PH.1.5" />
      <tag name="Reference.CriterionID" value="4" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>685967b9-f1cb-4156-a4dd-f9aed4a58568</id>
      <name>PH.1.5#05</name>
      <notes>The system MAY provide the ability to manage consent and authorization forms on-line according to user preference, organizational policy, and/or jurisdictional law.</notes>
