    </object>
    <object>
      <id>a06edf3b-9bf1-44b7-9ac7-db8dfb12990d</id>
      <name>RI.1.1.1#08</name>
      <notes>The system SHOULD capture metadata that identifies the source of non-originated Record Entry (e.g., templated, copied, duplicated, or boilerplate information).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
