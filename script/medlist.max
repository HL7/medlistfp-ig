    </object>
    <object>
      <id>a56d7348-e412-4beb-acfc-a92d14b21e65</id>
      <name>PH.1.5#09</name>
      <notes>The system SHOULD provide the ability to manage documentation related to a PHR Account Holder Proxy's consent or authorization according to user preference, organizational policy, and/or jurisdictional law.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>e1656db5-4b8e-4ac8-a0ef-ad1e764cdcb2</parentId>
