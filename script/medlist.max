      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>e6fef621-4092-42ae-9f07-73a1540c3b33</id>
      <name>PH.2.5.4#11</name>
      <notes>The system SHOULD present allergies, intolerances and adverse reactions that have been deactivated.</notes>
      <stereotype>Criteria</stereotype>
