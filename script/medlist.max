      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>9df71b92-8551-48cc-ab7b-b929649bab3a</id>
      <name>RI.1.1.1#07</name>
      <notes>The system SHALL provide the ability to capture the date/time an Action was taken or data was collected if different than date/time of the Record Entry.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
