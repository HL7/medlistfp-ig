      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>4616cc4a-ea8f-430f-ba5f-daabc5c2852b</id>
      <name>PH.1.5#06</name>
      <notes>The system SHOULD provide the ability to render consent and authorization forms (including, for example, in print-format) according to user preference, organizational policy, and/or jurisdictional law.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
