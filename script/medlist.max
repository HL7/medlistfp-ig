      <tag name="Reference.FunctionID" value="RI.1.1.1" />
      <tag name="Reference.CriterionID" value="8" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>ba9cb148-1957-446e-8795-80541565a2a6</id>
      <name>RI.1.1.1#09</name>
      <notes>The system MAY provide the ability to tag unstructured Record Entry content to organize it according to need, for example, in a time-related fashion or by application-specific groups (such as photographs, handwritten notes, or auditory sounds), or by order of relative importance.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
      <tag name="Row" value="789" />
      <tag name="Optionality" value="MAY" />
      <tag name="Conditional" value="N" />
      <tag name="Dependent" value="N" />
      <tag name="Reference.Alias" value="PHR_R2" />
      <tag name="Reference.FunctionID" value="RI.1.1.1" />
      <tag name="Reference.CriterionID" value="9" />
      <tag name="Reference.ChangeIndicator" value="NC" />
      <tag name="Priority" value="EN" />
    </object>
    <object>
      <id>06192e89-3d3c-47db-9dae-40adf45531de</id>
      <name>RI.1.1.1#10</name>
      <notes>The system MAY capture and maintain a Record Entry encoded as a standards-based data object (e.g., HL7 Continuity of Care, other HL7 CDA R2 Document, ISO 13606 artifact).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>9a5f5bbf-a7ac-42c3-95a1-b5ac730e146b</parentId>
