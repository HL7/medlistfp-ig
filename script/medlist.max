    </object>
    <object>
      <id>37e2955a-cfe6-42bc-9ce9-2367dc3e956b</id>
      <name>PH.1.5#07</name>
      <notes>The system MAY render electronic copies of authorization and/or consent directives associated with a specific clinical activity, such as a treatment or surgery according to user preference, organizational policy, and/or jurisdictional law.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>e1656db5-4b8e-4ac8-a0ef-ad1e764cdcb2</parentId>
