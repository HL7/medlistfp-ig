    <object>
      <id>546a7fa8-6871-4e46-9059-7421521c098d</id>
      <name>PH.3.5.4#09</name>
      <notes>The system MAY provide the ability to present options for the PHR Account Holder to configure preferences for notifications and/or reminders (e.g., posting on the PHR summary screen, e-mail, or text messages to another e-mail account or device).</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
