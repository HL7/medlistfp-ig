    </object>
    <object>
      <id>01478261-ea6a-4308-83a6-3f5c54ddc2ee</id>
      <name>S.2.1#05</name>
      <notes>The system SHOULD provide the ability to capture insurer(s) contact information.</notes>
      <stereotype>Criteria</stereotype>
      <type>Requirement</type>
      <parentId>d1b05ae0-4053-4fc9-bd1a-5ccb2de706e5</parentId>
      <tag name="Row" value="579" />
